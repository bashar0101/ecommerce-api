# Copy this file to .env and fill in your local values.
# .env is gitignored - never commit it.
#
# A "#" only starts a comment at the START of a line. Inline, it becomes part of
# the value: DB_USER=root # note  sets the username to the literal "root # note".

# --- Database ---
DB_USER=root
DB_PASSWORD=password

# --- Auth ---
# Must be at least 32 bytes. Keys.hmacShaKeyFor rejects anything shorter and the
# application will refuse to start.
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# --- Mail ---
# Defaults target the Mailpit container from compose.yaml (read the inbox at
# http://localhost:8025). Leave unset to use localhost:1025.
MAIL_HOST=localhost
MAIL_PORT=1025

# Prefix for the activation links in verification emails. Must be a URL the
# recipient's browser can reach.
APP_BASE_URL=http://localhost:8080
