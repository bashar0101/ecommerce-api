# Copy this file to .env and fill in your local values.
# .env is gitignored - never commit it.
#
# A "#" only starts a comment at the START of a line. Inline, it becomes part of
# the value: DB_USER=root # note  sets the username to the literal "root # note".
#
# On Render none of this file is used — the same keys are set as environment
# variables, most of them wired up automatically by render.yaml.

# --- Database (PostgreSQL) ---
# Defaults in application.properties are localhost:5432/ecommerce, so you only
# need these if yours differs. For the compose Postgres, use port 5433.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=password

# --- Auth ---
# Must be at least 32 bytes. Keys.hmacShaKeyFor rejects anything shorter and the
# application will refuse to start.
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# --- Mail ---
# Defaults target the Mailpit container from compose.yaml (read the inbox at
# http://localhost:8025). A real provider also needs MAIL_USERNAME,
# MAIL_PASSWORD, MAIL_SMTP_AUTH=true and MAIL_SMTP_STARTTLS=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@ecommerce.local

# Gmail instead of Mailpit:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=<16-char app password, NOT your account password>
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
#   MAIL_FROM=you@gmail.com     # must match MAIL_USERNAME or Gmail refuses to relay

# Prefix for the activation links in verification emails. Must be a URL the
# recipient's browser can reach. On Render: https://<your-service>.onrender.com
APP_BASE_URL=http://localhost:8080
