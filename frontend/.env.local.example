# Copy to .env.local to point the app at a different backend.
# Without it the app uses the deployed API below.
#
# NEXT_PUBLIC_ means the value is baked into the browser bundle, so never put a
# secret here. The base URL is public anyway.
NEXT_PUBLIC_API_URL=https://ecommerce-api-5gra.onrender.com

# Local backend instead:
# NEXT_PUBLIC_API_URL=http://localhost:8080
